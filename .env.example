# Copy to .env and fill in your own values. .env is git-ignored.

# Apple Developer Team ID (10 characters, shown in your developer account under Membership).
DEVELOPMENT_TEAM=XXXXXXXXXX

# Reverse-DNS prefix for bundle identifiers, e.g. com.example → com.example.ExcitingCompressor
BUNDLE_ID_PREFIX=com.example

# Signing identity for the .pkg, as listed by `security find-identity -v`.
INSTALLER_IDENTITY="Developer ID Installer: Your Name (XXXXXXXXXX)"

# Optional: notarytool keychain profile. When set, make-installer.sh notarizes and staples.
# Create it once with:
#   xcrun notarytool store-credentials <profile> --apple-id <id> --team-id <DEVELOPMENT_TEAM>
NOTARY_PROFILE=
